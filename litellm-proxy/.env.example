# Copy to .env and fill in real values. Never commit the real .env.

# Google AI Studio key (https://aistudio.google.com/apikey) — used for the
# gemini-flash / gemini-pro entries in config.yaml.
GEMINI_API_KEY=your-gemini-api-key

# Optional: uncomment the matching entry in config.yaml to also route your
# own OpenAI/ChatGPT subscription through this same proxy.
# OPENAI_API_KEY=your-openai-api-key

# Key ai-assist (or any other client) must send to *this* proxy. Make this up
# yourself — it's not a provider key, just an access key for your own proxy.
LITELLM_MASTER_KEY=sk-choose-your-own-local-key

# Optional: host port to publish (default 4000). Override if something else
# on your machine already listens on 4000 (e.g. a personal LiteLLM instance).
# LITELLM_PORT=4001
