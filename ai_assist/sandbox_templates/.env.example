# ai-assist sandbox credentials
# Copy this file to .env and fill in your credentials.
# Each variable is injected ONLY into the service that needs it (see compose.yaml).

# Claude API (ai-assist container only)
ANTHROPIC_API_KEY=
# Or for Vertex AI:
# ANTHROPIC_VERTEX_PROJECT_ID=
# ANTHROPIC_VERTEX_REGION=
# Or for a custom Anthropic-Messages-compatible endpoint (OpenRouter / self-hosted / proxy):
# ANTHROPIC_BASE_URL=https://openrouter.ai/api
# AI_ASSIST_API_KEY=
# AI_ASSIST_MODEL=anthropic/claude-sonnet-4.6
# Permission mode: manual (default), auto, or autonomous. Autonomous disables
# ai-assist command/path prompts inside this sandbox; enable only with intended
# features and credentials.
# AI_ASSIST_PERMISSION_MODE=autonomous

# DCI (dci-mcp-server container only)
DCI_CLIENT_ID=
DCI_API_SECRET=
# DCI_CS_URL=https://api.distributed-ci.io/api/v1

# Jira (dci-mcp-server container only)
JIRA_API_TOKEN=
# JIRA_URL=https://redhat.atlassian.net
# JIRA_WRITE_ENABLED=false

# GitHub (dci-mcp-server container only)
GITHUB_TOKEN=

# GitLab (dci-mcp-server container only)
GITLAB_TOKEN=
# GITLAB_URL=https://gitlab.cee.redhat.com

# Red Hat API (dci-mcp-server container only)
OFFLINE_TOKEN=

# litellm feature (litellm container only): fronts non-Anthropic models
# (Gemini, OpenAI/ChatGPT) behind the Anthropic-Messages dialect ai-assist
# speaks. The ai-assist container never sees these — only LITELLM_MASTER_KEY
# (auto-wired as its ANTHROPIC_BASE_URL/AI_ASSIST_API_KEY). Fill in only the
# providers you actually use; edit sandbox/.ai-assist/litellm_config.yaml to
# add/remove model aliases. Set AI_ASSIST_MODEL to one of its model_name
# entries (gemini-flash, gemini-pro, gpt-5).
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# LITELLM_MASTER_KEY=sk-choose-your-own-local-key
