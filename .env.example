# Anthropic API Configuration (REQUIRED - Choose ONE method)
#
# METHOD 1: Vertex AI (Google Cloud) - Recommended for enterprise
# Use this if your company uses Claude via Google Cloud Vertex AI
# Requires: gcloud auth application-default login
# ANTHROPIC_VERTEX_PROJECT_ID=your-gcp-project-id
# ANTHROPIC_VERTEX_REGION=us-east5  # Optional - SDK auto-selects region if not specified
#
# METHOD 2: Direct API Key - For personal use or free tier
# Get your API key from: https://console.anthropic.com/
# Free tier available ($5 credit for new accounts)
ANTHROPIC_API_KEY=your_api_key_here
#
# METHOD 3: Custom Anthropic-Messages-compatible endpoint (takes precedence)
# For OpenRouter, self-hosted models, or a proxy. The endpoint must speak the
# Anthropic Messages API. OpenRouter (Claude models) and self-hosted vLLM/Ollama/
# llama.cpp expose it natively; for OpenAI-only backends front them with a proxy
# (LiteLLM proxy or claude-code-router).
#   OpenRouter:  ANTHROPIC_BASE_URL=https://openrouter.ai/api   (model: anthropic/claude-sonnet-4.6)
#   Ollama:      ANTHROPIC_BASE_URL=http://localhost:11434      (AI_ASSIST_API_KEY=ollama)
#   vLLM:        ANTHROPIC_BASE_URL=http://localhost:8000
# ANTHROPIC_BASE_URL=https://openrouter.ai/api
# AI_ASSIST_API_KEY=your-endpoint-key
#
# Model configuration (applies to all methods)
# For Claude 4.6+ use dateless IDs (e.g., claude-sonnet-4-6, claude-opus-4-6)
# For older models use @ format (e.g., claude-sonnet-4-5@20250929)
# For custom endpoints use the provider's model id (e.g., anthropic/claude-sonnet-4.6)
AI_ASSIST_MODEL=claude-sonnet-4-6
#
# Optional per-role model overrides (fall back to AI_ASSIST_MODEL when unset)
# AI_ASSIST_SYNTHESIS_MODEL=claude-haiku-4-5     # KG synthesis / connection discovery
# AI_ASSIST_COMPACTION_MODEL=claude-haiku-4-5    # conversation memory compaction
#
# Prompt caching: set to false for endpoints that don't support Anthropic ephemeral caching
# AI_ASSIST_ENABLE_CACHE=true
#
# Capability overrides for custom/self-hosted models not in the built-in tables
# AI_ASSIST_MODEL_MAX_TOKENS=8192
# AI_ASSIST_MODEL_CONTEXT_WINDOW=200000
#
# MLflow tracing (optional GenAI observability). Requires: pip install 'ai-assist[mlflow]'
# AI_ASSIST_ENABLE_MLFLOW=true
# MLFLOW_TRACKING_URI=http://localhost:5000        # unset => local SQLite store at <config dir>/mlflow.db
# AI_ASSIST_MLFLOW_EXPERIMENT=ai-assist

# Notification Settings
ENABLE_NOTIFICATIONS=true
NOTIFICATION_CHANNEL=console

# Report directory
AI_ASSIST_REPORTS_DIR=~/ai-assist/reports

# Agent Skills Script Execution (SECURITY: Disabled by default)
# WARNING: Enabling this allows installed Agent Skills to execute scripts
# Only enable if you trust the skills you install from third parties
# See SECURITY.md for details on security controls
# AI_ASSIST_ALLOW_SCRIPT_EXECUTION=true

# Context Window
# Claude 4.6+ models have native 1M context windows (no opt-in needed)
